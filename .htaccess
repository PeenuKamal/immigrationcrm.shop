# ImmigrationCRM.shop — Apache / LiteSpeed (Hostinger) configuration
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS (skipped on localhost)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One address for search engines: www → bare domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Keep code and settings private
  RewriteRule ^(app|\.git)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|README\.md|SETUP\.md|composer\.(json|lock)|\.gitignore)$ - [F,L]

  # Real files (images, CSS, install.php) are served directly; everything else goes to index.php
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" env=HTTPS
  <FilesMatch "\.(css|js|png|svg|ico|ttf|webp|jpg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/markdown application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml
</IfModule>

AddType text/markdown .md
AddType application/manifest+json .webmanifest

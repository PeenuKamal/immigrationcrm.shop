# Copy this file to .env on your server and fill in the blanks.
# NEVER commit .env — this repository is public.

# Public address of the site (no trailing slash)
APP_URL=https://immigrationcrm.shop

# PostgreSQL connection string. On Hostinger Node.js hosting use Supabase's "Session pooler" string.
# Tables and starter listings are created automatically the first time the site starts.
DATABASE_URL=postgres://immigrationcrm:CHANGE_ME@localhost:5432/immigrationcrm

# Long random string that signs login sessions. Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Admin(s) who see the Moderation dashboard (comma-separated)
ADMIN_EMAILS=kamal@thedigisparrow.com
# Contact address shown on the site
CONTACT_EMAIL=kamal@thedigisparrow.com

# Hostinger email for login codes and notifications
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=otp@immigrationcrm.shop
SMTP_PASS=
EMAIL_FROM="ImmigrationCRM.shop <otp@immigrationcrm.shop>"

# LinkedIn "Sign In with LinkedIn using OpenID Connect" app
# Redirect URL to register: https://immigrationcrm.shop/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Stripe, for paid featured placement
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price per month in the smallest currency unit (9900 = $99.00; for INR, 799900 = ₹7,999)
FEATURED_PRICE_CENTS=9900
FEATURED_CURRENCY=usd

# Hold every review for manual approval even when fully verified (true/false)
REQUIRE_ADMIN_APPROVAL=false

# --- Search engines & AI search ---
# Google Search Console "HTML tag" verification code (just the content="..." value)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta tag value (Bing also powers ChatGPT search and Microsoft Copilot)
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
# IndexNow key: any 32-character hex string. Generate with:  openssl rand -hex 16
INDEXNOW_KEY=
